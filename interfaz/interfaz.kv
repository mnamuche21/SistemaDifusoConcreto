#:kivy 2.2.1

<Ventana>:
    orientation: "vertical"

    canvas.before:
        Color:
            rgba: .96, .97, .98, 1  # Fondo gris claro suave
        Rectangle:
            pos: self.pos
            size: self.size

    # ScrollView permite que en celulares no se corte la interfaz al abrir el teclado
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: [20, 24, 20, 24]
            spacing: 16

            # --- CABECERA ---
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: 4

                Label:
                    text: "Predicción de Resistencia"
                    font_size: "22sp"
                    bold: True
                    color: .1, .1, .15, 1
                    size_hint_y: None
                    height: 32
                    halign: "center"

                Label:
                    text: "Sistema Experto Difuso • Concreto"
                    font_size: "13sp"
                    color: .4, .4, .5, 1
                    size_hint_y: None
                    height: 20
                    halign: "center"

            # --- TARJETA DE ENTRADAS ---
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [16, 18, 16, 18]
                spacing: 14

                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]

                GridLayout:
                    cols: 2
                    spacing: [10, 12]
                    row_default_height: 44
                    row_force_default: True
                    size_hint_y: None
                    height: self.minimum_height

                    # Campo 1
                    Label:
                        text: "Cemento (kg/m³)"
                        font_size: "14sp"
                        halign: "left"
                        valign: "center"
                        text_size: self.size
                        color: .2, .25, .3, 1

                    TextInput:
                        id: cemento
                        multiline: False
                        input_filter: "float"
                        font_size: "15sp"
                        padding: [10, 10, 10, 10]
                        background_normal: ''
                        background_color: .95, .96, .98, 1
                        foreground_color: .1, .1, .1, 1

                    # Campo 2
                    Label:
                        text: "Agua (kg/m³)"
                        font_size: "14sp"
                        halign: "left"
                        valign: "center"
                        text_size: self.size
                        color: .2, .25, .3, 1

                    TextInput:
                        id: agua
                        multiline: False
                        input_filter: "float"
                        font_size: "15sp"
                        padding: [10, 10, 10, 10]
                        background_normal: ''
                        background_color: .95, .96, .98, 1
                        foreground_color: .1, .1, .1, 1

                    # Campo 3
                    Label:
                        text: "Superplast. (kg/m³)"
                        font_size: "14sp"
                        halign: "left"
                        valign: "center"
                        text_size: self.size
                        color: .2, .25, .3, 1

                    TextInput:
                        id: superplastificante
                        multiline: False
                        input_filter: "float"
                        font_size: "15sp"
                        padding: [10, 10, 10, 10]
                        background_normal: ''
                        background_color: .95, .96, .98, 1
                        foreground_color: .1, .1, .1, 1

                    # Campo 4
                    Label:
                        text: "Agregado Fino (kg/m³)"
                        font_size: "14sp"
                        halign: "left"
                        valign: "center"
                        text_size: self.size
                        color: .2, .25, .3, 1

                    TextInput:
                        id: fino
                        multiline: False
                        input_filter: "float"
                        font_size: "15sp"
                        padding: [10, 10, 10, 10]
                        background_normal: ''
                        background_color: .95, .96, .98, 1
                        foreground_color: .1, .1, .1, 1

                    # Campo 5
                    Label:
                        text: "Edad (días)"
                        font_size: "14sp"
                        halign: "left"
                        valign: "center"
                        text_size: self.size
                        color: .2, .25, .3, 1

                    TextInput:
                        id: edad
                        multiline: False
                        input_filter: "int"
                        font_size: "15sp"
                        padding: [10, 10, 10, 10]
                        background_normal: ''
                        background_color: .95, .96, .98, 1
                        foreground_color: .1, .1, .1, 1

            # --- BOTÓN DE ACCIÓN ---
            Button:
                text: "CALCULAR RESISTENCIA"
                size_hint_y: None
                height: 50
                font_size: "14sp"
                bold: True
                background_normal: ""
                background_color: .1, .42, .88, 1
                color: 1, 1, 1, 1
                on_release: root.calcular()

            # --- TARJETA DE RESULTADO ---
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 100
                padding: [12, 12, 12, 12]
                spacing: 4

                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]

                Label:
                    text: "Resistencia Estimada"
                    font_size: "12sp"
                    color: .5, .5, .5, 1
                    size_hint_y: None
                    height: 18

                Label:
                    id: resultado
                    text: "-- MPa --"
                    font_size: "28sp"
                    bold: True
                    color: .1, .42, .88, 1


Ventana: